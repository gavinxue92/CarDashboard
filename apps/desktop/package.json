{
  "name": "@cd/desktop",
  "productName": "CarDashboard",
  "version": "0.1.3",
  "private": true,
  "description": "海外获客沟通工作台 · Windows 客户端（V1 单机版）",
  "author": "CarDashboard Team",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "pack:win": "pnpm run build && electron-builder --win --config electron-builder.yml",
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['out','release'])fs.rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@cd/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
